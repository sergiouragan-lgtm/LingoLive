{
  "entities": {
    "User": {
      "title": "User",
      "description": "Core authentication user attributes",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 256 },
        "role": { "type": "string", "maxLength": 100 },
        "emailVerified": { "type": "boolean" },
        "mfaEnabled": { "type": "boolean" },
        "lastLoginAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "role", "emailVerified", "mfaEnabled"]
    },
    "Profile": {
      "title": "Profile",
      "description": "User profile metadata",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "firstName": { "type": "string", "maxLength": 100 },
        "lastName": { "type": "string", "maxLength": 100 },
        "displayName": { "type": "string", "maxLength": 150 },
        "avatarUrl": { "type": "string", "maxLength": 2048 }
      },
      "required": ["userId", "firstName", "lastName", "displayName"]
    },
    "School": {
      "title": "School",
      "description": "Educational institutions on the LingoLIVE platform",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 200 },
        "ownerUid": { "type": "string", "maxLength": 128 },
        "maxStudents": { "type": "integer" },
        "currentStudentsCount": { "type": "integer" }
      },
      "required": ["name", "ownerUid"]
    },
    "Teacher": {
      "title": "Teacher",
      "description": "Platform instructors",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "schoolId": { "type": "string", "maxLength": 128 },
        "isNativeTeacher": { "type": "boolean" }
      },
      "required": ["userId", "schoolId"]
    },
    "GraphNode": {
      "title": "GraphNode",
      "description": "Semantic graph node",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "type": { "type": "string", "maxLength": 50 },
        "data": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "type", "createdAt"]
    },
    "Exam": {
      "title": "Exam",
      "description": "Assessment exam definition",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 }
      },
      "required": ["id", "title"]
    },
    "ScheduledExam": {
      "title": "ScheduledExam",
      "description": "Scheduled exam for user",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "userId"]
    },
    "ExamAttempt": {
      "title": "ExamAttempt",
      "description": "User exam attempt result",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "userId"]
    },
    "Certificate": {
      "title": "Certificate",
      "description": "Earned certificate",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "userId"]
    },
    "Settings": {
      "title": "Settings",
      "description": "Global and platform settings",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "vibrationDuration": { "type": "number" }
      },
      "required": ["id"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Users identity mappings"
    },
    "/profiles/{profileId}": {
      "schema": "Profile",
      "description": "User demographics and profiles"
    },
    "/schools/{schoolId}": {
      "schema": "School",
      "description": "Isolated institutional tenants"
    },
    "/teachers/{teacherId}": {
      "schema": "Teacher",
      "description": "Teacher registration schemas"
    },
    "/graph_nodes/{nodeId}": {
      "schema": "GraphNode",
      "description": "Semantic graph nodes"
    },
    "/graph_edges/{edgeId}": {
      "schema": "GraphEdge",
      "description": "Semantic graph edges"
    },
    "/assessment_exams/{examId}": {
      "schema": "Exam",
      "description": "Assessment exams"
    },
    "/assessment_scheduled/{schedId}": {
      "schema": "ScheduledExam",
      "description": "Scheduled exams"
    },
    "/assessment_attempts/{attemptId}": {
      "schema": "ExamAttempt",
      "description": "Exam attempts"
    },
    "/assessment_certificates/{certId}": {
      "schema": "Certificate",
      "description": "Certificates"
    },
    "/settings/{settingsId}": {
      "schema": "Settings",
      "description": "Global and platform settings"
    },
    "/learningStatistics/{statId}": {
      "description": "User and class learning statistics"
    },
    "/announcements/{announcementId}": {
      "description": "Daily announcements and platform notices"
    },
    "/user_gamification/{userId}": {
      "description": "User XP, level, streak, and gamification state"
    }
  }
}
