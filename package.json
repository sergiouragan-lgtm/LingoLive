{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npx tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "NODE_ENV=production node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:ci": "vitest run",
    "test:firestore-rules": "firebase emulators:exec --only firestore \"vitest run --config vitest.firestore.config.ts\"",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "check": "npm run typecheck && npm run test:ci && npm run test:firestore-rules && npm run audit:prod && npm run build"
  },
  "dependencies": {
    "@elevenlabs/client": "^1.25.0",
    "@google-cloud/storage": "^8.1.0",
    "@google/genai": "^2.22.0",
    "@stripe/stripe-js": "^9.16.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jspdf": "^2.0.0",
    "@types/jszip": "^3.4.1",
    "@types/pdfkit": "^0.17.6",
    "@vitejs/plugin-react": "^6.1.1",
    "@yudiel/react-qr-scanner": "^2.6.0",
    "body-parser": "^2.3.0",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.4.0",
    "ioredis": "^6.0.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "jszip": "^3.10.2",
    "livekit-client": "^2.20.0",
    "lru-cache": "^11.5.2",
    "lucide-react": "^1.46.0",
    "motion": "^13.2.0",
    "openai": "^7.15.0",
    "pdfkit": "^0.20.2",
    "qs": "^6.16.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.28.0",
    "stripe": "^22.6.2",
    "tsyringe": "^4.10.0",
    "uuid": "^14.0.2",
    "vite": "^8.3.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "firebase-tools": "^15.30.1",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.5",
    "typescript": "~5.8.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
