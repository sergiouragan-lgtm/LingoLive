{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npx tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "NODE_ENV=production node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:ci": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:ui": "playwright test --ui",
    "test:firestore-rules": "firebase emulators:exec --only firestore \"vitest run --config vitest.firestore.config.ts\"",
    "test:coverage": "vitest run --coverage",
    "generate:openapi": "node scripts/generate-openapi.mjs",
    "generate:tests": "npx tsx scripts/generate-test-files.ts",
    "setup:firestore": "npx tsx scripts/firestore-setup.ts",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "check": "npm run typecheck && npm run test:ci && npm run test:integration && npm run test:firestore-rules && npm run audit:prod && npm run build"
  },
  "dependencies": {
    "@elevenlabs/client": "^1.14.0",
    "@google-cloud/storage": "^8.1.0",
    "@google/genai": "^2.24.0",
    "@stripe/stripe-js": "^9.17.0",
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/user-event": "^14.6.1",
    "@types/bull": "^4.10.4",
    "@types/jspdf": "^2.0.0",
    "@types/jszip": "^3.4.1",
    "@types/pdfkit": "^0.17.6",
    "@vitejs/plugin-react": "^6.1.1",
    "@yudiel/react-qr-scanner": "^2.6.0",
    "body-parser": "^2.3.0",
    "bull": "^4.16.5",
    "cors": "^2.8.6",
    "dotenv": "^18.0.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "firebase": "^12.15.0",
    "firebase-admin": "^14.4.0",
    "firebase-functions": "^7.4.0",
    "ioredis": "^6.0.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "jszip": "^3.10.1",
    "livekit-client": "^2.20.0",
    "lru-cache": "^11.5.2",
    "lucide-react": "^1.47.0",
    "motion": "^13.4.0",
    "nodemailer": "^10.0.10",
    "openai": "^7.21.0",
    "pdfkit": "^0.20.2",
    "qrcode": "^1.5.4",
    "qs": "^6.16.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.9.0",
    "redis": "^6.2.1",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.14.0",
    "socket.io": "^4.8.3",
    "speakeasy": "^2.0.0",
    "stripe": "^22.3.1",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "tsyringe": "^4.10.0",
    "uuid": "^14.0.2",
    "vite": "^8.3.0",
    "ws": "^8.21.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.20.4",
    "@types/nodemailer": "^8.0.2",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^5.0.1",
    "autoprefixer": "^10.4.21",
    "axios": "^1.20.0",
    "esbuild": "^0.25.0",
    "firebase-tools": "^10.1.1",
    "jsdom": "^29.1.1",
    "livekit-server-sdk": "^2.19.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.5",
    "typescript": "~5.8.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
