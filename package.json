{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npx tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "NODE_ENV=production node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:ci": "vitest run",
    "test:firestore-rules": "firebase emulators:exec --only firestore \"vitest run --config vitest.firestore.config.ts\"",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "check": "npm run typecheck && npm run test:ci && npm run test:firestore-rules && npm run audit:prod && npm run build"
  },
  "dependencies": {
    "@elevenlabs/client": "^1.14.0",
    "@google-cloud/storage": "^8.1.0",
    "@google/genai": "^2.4.0",
    "@stripe/stripe-js": "^9.8.0",
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/user-event": "^14.6.1",
    "@types/jspdf": "^1.3.3",
    "@types/jszip": "^3.4.0",
    "@types/pdfkit": "^0.17.6",
    "@vitejs/plugin-react": "^5.0.4",
    "@yudiel/react-qr-scanner": "^2.6.0",
    "body-parser": "^2.3.0",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "firebase": "^12.15.0",
    "firebase-admin": "^14.4.0",
    "ioredis": "^5.11.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "jszip": "^3.10.1",
    "livekit-client": "^2.20.0",
    "lru-cache": "^11.5.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "openai": "^6.45.0",
    "pdfkit": "^0.19.1",
    "qs": "^6.16.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.9.0",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.14.0",
    "stripe": "^22.3.1",
    "tsyringe": "^4.10.0",
    "uuid": "^11.1.1",
    "vite": "^6.2.3",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.5.1",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.6.0",
    "esbuild": "^0.28.2",
    "firebase-tools": "^15.30.1",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "~7.0.2",
    "vite": "^6.2.3",
    "vitest": "^5.0.1"
  }
}
